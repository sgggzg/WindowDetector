<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_alarm_window"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvAlertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="占领警报"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#E94560"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvAlertTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:00:00"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <!-- 【核心修复】使用固定高度的 ScrollView 包裹内容区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#16213E"
        android:padding="16dp"
        android:scrollbars="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvAlertContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="检测到目标公告内容"
            android:textSize="16sp"
            android:textColor="#FFFFFF" />
    </ScrollView>

    <TextView
        android:id="@+id/tvAlertCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已报警 1 次"
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="关闭并静音（30秒冷却）"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:background="#E94560"
        android:padding="14dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="false" />
</LinearLayout>
